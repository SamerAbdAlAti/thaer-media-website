---
import '@fontsource-variable/manrope';
import '../styles/site.css';
import manropeLatin from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, whatsappUrl } from '../lib/site';
import { SOCIAL_ICONS } from '../lib/icons';
import { type Lang, type RouteKey, dirOf, href, other, asset, ui, tr } from '../lib/i18n';

interface Props {
  lang: Lang;
  route: RouteKey | '404';
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: { src: string; width: number; height: number; alt: string };
  page: 'home' | 'contact' | 'gallery' | 'course' | 'notfound';
  footer?: 'full' | 'simple';
  noindex?: boolean;
}
const { lang, route, title, description, ogTitle, ogDescription, ogImage, page, footer = 'full', noindex = false } = Astro.props;
const dir = dirOf(lang);
const is404 = route === '404';
const routeKey = is404 ? '' : (route as RouteKey);

// Absolute URLs need the site URL, which the deploy workflow provides.
const abs = (path: string) => (Astro.site ? new URL(path, Astro.site).href : undefined);
const canonical = is404 ? undefined : abs(href(lang, routeKey));
const alternates = is404 ? [] : [
  { hreflang: 'ar', url: abs(href('ar', routeKey)) },
  { hreflang: 'en', url: abs(href('en', routeKey)) },
  { hreflang: 'x-default', url: abs(href('ar', routeKey)) },
];
const altPage = is404 ? '' : href(other(lang), routeKey);
const ogImg = ogImage ? abs(asset(ogImage.src)) : undefined;
const arabicFont = 'https://db.onlinewebfonts.com/t/9004b72f96afb1e5f13389f489791113.woff2';
const prefetchRules = JSON.stringify({
  prefetch: [{ where: { href_matches: `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}*` }, eagerness: 'moderate' }],
});
// Before first paint: theme (no light/dark flash), .js flag for entrance animations, and the visitor's
// saved language (same behaviour as the live site: a visitor who chose English keeps getting English).
const prePaint = `(function(){var d=document.documentElement;d.classList.add('js');try{var t=localStorage.getItem('theme');if(t==='light'){d.setAttribute('data-theme','light');var m=document.querySelector('meta[name=theme-color]');if(m)m.content='#f4f9f5'}var l=localStorage.getItem('lang'),a=d.getAttribute('data-alt');if(a&&l&&l!==d.lang)location.replace(a+location.hash)}catch(e){}})()`;
---
<!doctype html>
<html lang={lang} dir={dir} data-alt={altPage || undefined}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#063632">
  <script is:inline set:html={prePaint} />
  <title>{title}</title>
  <meta name="description" content={description}>
  {noindex && <meta name="robots" content="noindex">}
  {canonical && <link rel="canonical" href={canonical}>}
  {alternates.map((a) => a.url && <link rel="alternate" hreflang={a.hreflang} href={a.url}>)}

  <link rel="preconnect" href="https://db.onlinewebfonts.com" crossorigin>
  {lang === 'ar'
    ? <link rel="preload" href={arabicFont} as="font" type="font/woff2" crossorigin>
    : <link rel="preload" href={manropeLatin} as="font" type="font/woff2" crossorigin>}

  <link rel="icon" type="image/png" sizes="32x32" href={asset('favicon-32.png')}>
  <link rel="icon" type="image/png" sizes="192x192" href={asset('icon-192.png')}>
  <link rel="apple-touch-icon" href={asset('apple-touch-icon.png')}>

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Thaer Media">
  <meta property="og:locale" content={lang === 'ar' ? 'ar_AR' : 'en_US'}>
  <meta property="og:locale:alternate" content={lang === 'ar' ? 'en_US' : 'ar_AR'}>
  <meta property="og:title" content={ogTitle ?? title}>
  <meta property="og:description" content={ogDescription ?? description}>
  {canonical && <meta property="og:url" content={canonical}>}
  {ogImg && ogImage && <>
    <meta property="og:image" content={ogImg}>
    <meta property="og:image:type" content="image/png">
    <meta property="og:image:width" content={String(ogImage.width)}>
    <meta property="og:image:height" content={String(ogImage.height)}>
    <meta property="og:image:alt" content={ogImage.alt}>
    <meta name="twitter:image" content={ogImg}>
  </>}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={ogTitle ?? title}>
  <meta name="twitter:description" content={ogDescription ?? description}>
  <slot name="head" />
  <!-- Chromium browsers fetch internal pages on hover/press, so navigation feels instant. No JS cost. -->
  <script type="speculationrules" set:html={prefetchRules} />
</head>
<body data-page={page}>
  <a class="skip-link" href="#main">{tr(ui.skip, lang)}</a>
  <Header lang={lang} route={route} page={page} />
  <main id="main">
    <slot />
  </main>
  <Footer lang={lang} variant={footer} page={page} />
  <aside aria-label="WhatsApp">
    <a class="floating-whatsapp" href={whatsappUrl()} target="_blank" rel="noopener noreferrer" aria-label={tr(site.footer.whatsappButton, lang)}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d={(SOCIAL_ICONS.whatsapp as { d: string }).d} /></svg>
    </a>
  </aside>
  <script>
    import '../scripts/site';
  </script>
</body>
</html>
